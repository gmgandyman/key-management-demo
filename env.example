# Copy this file to .env on your local instance

# This is here for Windows/WSL users, because the ansible directory cannot have it's chmod bits set
ANSIBLE_CONFIG=/work/ansible/ansible.cfg

# docker compose will read this one automagically
COMPOSE_PROJECT_NAME=key-demo

NETWORK_NAME=demo-net
IMAGE_TAG=key-demo

TOOLBOX_IMAGE_NAME=demo-toolbox
TOOLBOX_SERVICE_NAME=toolbox

BASE_IMAGE_NAME=base-server
POSTGRES_IMAGE_NAME=postgres-server
NGINX_IMAGE_NAME=nginx-server
APACHE_IMAGE_NAME=apache-server
BASTION_IMAGE_NAME=bastion-server
API_IMAGE_NAME=api-endpoint-server

# Static IPs on demo-net (10.20.30.0/24, gateway .1)
TOOLBOX_IP=10.20.30.2
POSTGRES_IP=10.20.30.3
NGINX_IP=10.20.30.4
APACHE_IP=10.20.30.5
BASTION_IP=10.20.30.6
API_ENDPOINT_IP=10.20.30.7

# Spring Boot API
API_HTTP_PORT=8080

# Where run-api.sh looks for the built jar. Dev = the bind-mounted api/target;
API_JAR_DIR=/work/api/target
JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# Spring reads these via relaxed binding, no application.yml edit needed.
# NOTE: the postgres role still needs listen_addresses='*' + a pg_hba scram rule
SPRING_PROFILES_ACTIVE=container
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres-db:5432/authorized_keys
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres

MASTER_KEY_PATH=/home/deploy/.ssh/id_ed25519
USERS_KEY_PATH=/work/keys/users/

# Public release variables
PUBLIC_RELEASE_DESTINATION=